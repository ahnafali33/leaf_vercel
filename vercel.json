{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{firebase-applet-config.json,src/data/db.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/google(.*)\\.html",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|sitemap\\.xml|robots\\.txt|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
